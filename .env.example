# ====================================================================
# LOOP & LOVE CROCHET E-COMMERCE - ENVIRONMENT CONFIGURATION
# ====================================================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY
# (When left empty, the application runs in high-fidelity sandbox simulation mode)
# --------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --------------------------------------------------------------------
# SUPABASE / POSTGRESQL (OPTIONAL PRODUCTION ADAPTER)
# (When left empty, the application runs on the robust built-in ACID database in .data/)
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------
# TRANSACTIONAL EMAIL (RESEND) - OPTIONAL
# --------------------------------------------------------------------
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=admin@loopandlove.com
